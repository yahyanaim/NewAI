// YouTube Live Stream Service
// Dynamically fetches current live stream video IDs for news channels

export interface LiveChannelData {
  id: string;
  name: string;
  country: string;
  description: string;
  logo: string;
  language: string;
  region: string;
  channelId: string; // YouTube channel ID
  videoId?: string; // Current live stream video ID
  isLive: boolean;
  lastChecked: number;
  error?: string;
}

